rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Diretório: qualquer pessoa logada vê nome/e-mail/foto para escolher parceiros.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Dados pessoais (clientes, peso, treino, alimentação, leitura, cursos): só o dono.
      match /dados/{secao} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Atendimentos compartilhados: só quem participa vê.
    match /atendimentos/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null
        && request.resource.data.criadoPor == request.auth.uid
        && request.auth.uid in request.resource.data.participantes;
      // Organizador edita tudo; participante só pode se retirar da lista.
      allow update: if request.auth != null && (
        (resource.data.criadoPor == request.auth.uid && request.resource.data.criadoPor == request.auth.uid)
        || (request.auth.uid in resource.data.participantes
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantes'])
            && !(request.auth.uid in request.resource.data.participantes))
      );
      allow delete: if request.auth != null && resource.data.criadoPor == request.auth.uid;
    }
  }
}
