rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= quem pode usar o Foco =================
    // Só entra quem é o administrador ou está na lista config/acesso.emails (editada pelo próprio app, em Ajustes).
    function logado() {
      return request.auth != null && request.auth.token.email != null && request.auth.token.email_verified == true;
    }
    function meuEmail() { return request.auth.token.email.lower(); }
    function admin() { return logado() && meuEmail() == '1imovjund@gmail.com'; }
    function liberado() {
      return admin() || (logado()
        && exists(/databases/$(database)/documents/config/acesso)
        && meuEmail() in get(/databases/$(database)/documents/config/acesso).data.emails);
    }

    // ================= formatos aceitos =================
    function idOk(id) { return id is string && id.matches('^[A-Za-z0-9_-]{1,40}$'); }
    function texto(m, k, max) { return !(k in m) || m[k] == null || (m[k] is string && m[k].size() <= max); }
    function lista(m, k, max) { return !(k in m) || m[k] == null || (m[k] is list && m[k].size() <= max); }
    function numero(m, k) { return !(k in m) || m[k] == null || m[k] is number; }
    function pessoas(l) { return l is list && l.size() >= 1 && l.size() <= 20; }

    function clienteOk(c) {
      return c is map
        && c.keys().hasOnly(['nome','fone','produtoId','produtoNome','corretorNome','etapa','temp','lembrete','notas','valor','contatos','historico','vendaEm','criado'])
        && texto(c, 'nome', 120) && texto(c, 'fone', 40) && texto(c, 'produtoId', 60) && texto(c, 'produtoNome', 120)
        && texto(c, 'corretorNome', 80) && texto(c, 'notas', 5000) && texto(c, 'lembrete', 30) && texto(c, 'criado', 40)
        && (!('etapa' in c) || c.etapa in ['Novo lead','Contato feito','Visita','Visita agendada','Visita efetuada','Simulação','Análise de crédito','Proposta','Documentação','Venda','Perdido'])
        && (!('temp' in c) || c.temp == null || c.temp in ['Quente','Morno','Frio',''])
        && (!('valor' in c) || c.valor == null || c.valor is number || (c.valor is string && c.valor.size() <= 20))
        && (!('vendaEm' in c) || c.vendaEm == null || (c.vendaEm is string && c.vendaEm.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')))
        && lista(c, 'contatos', 500) && lista(c, 'historico', 500);
    }

    function atendOk(a) {
      return a.keys().hasOnly(['tipo','titulo','cliente','clienteId','produto','inicio','duracao','local','notas','participantes',
                               'emailsExtras','convite','criadoPor','status','atualizado','atualizadoPor','criado','eventId','iCalUID','htmlLink','cal'])
        && pessoas(a.participantes) && idOk(a.criadoPor)
        && texto(a, 'titulo', 200) && texto(a, 'clienteId', 60) && texto(a, 'produto', 200) && texto(a, 'local', 300)
        && texto(a, 'notas', 5000) && texto(a, 'emailsExtras', 1000) && texto(a, 'eventId', 200) && texto(a, 'iCalUID', 300)
        && texto(a, 'inicio', 30) && numero(a, 'duracao') && numero(a, 'atualizado') && numero(a, 'criado')
        && (!('status' in a) || a.status in ['ativo','realizado','cancelado'])
        && (!('tipo' in a) || a.tipo == 'cliente')
        && (!('htmlLink' in a) || a.htmlLink == null || (a.htmlLink is string && a.htmlLink.matches('^https://(www[.]google[.]com|calendar[.]google[.]com)/.*')))
        && (!('cliente' in a) || a.cliente == null || (a.cliente is string && a.cliente.size() <= 200) || clienteOk(a.cliente));
    }

    function compartilhadoOk(d) {
      return d.keys().hasOnly(['dono','membros','cliente','cal','criado','atualizado','atualizadoPor'])
        && idOk(d.dono) && pessoas(d.membros) && clienteOk(d.cliente)
        && (!('cal' in d) || d.cal is map) && numero(d, 'criado') && numero(d, 'atualizado');
    }

    // ================= lista de acesso =================
    match /config/acesso {
      allow read: if admin();
      allow write: if admin() && request.resource.data.keys().hasOnly(['emails'])
        && request.resource.data.emails is list && request.resource.data.emails.size() <= 100;
    }

    // ================= diretório de pessoas =================
    // Só quem está liberado vê nome/e-mail/foto (para escolher parceiros). Cada um só grava o próprio,
    // e o e-mail tem que ser o da conta Google de verdade (ninguém se passa por outro corretor).
    match /users/{uid} {
      allow read: if liberado();
      allow create, update: if liberado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nome','email','foto','visto'])
        && request.resource.data.email == meuEmail()
        && texto(request.resource.data, 'nome', 80)
        && (!('foto' in request.resource.data) || request.resource.data.foto == ''
            || (request.resource.data.foto is string && request.resource.data.foto.matches('^https://[a-z0-9.-]+[.]googleusercontent[.]com/.*') && request.resource.data.foto.size() <= 500))
        && numero(request.resource.data, 'visto');
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Dados pessoais (clientes, peso, treino, alimentação, leitura, cursos): só o dono.
      match /dados/{secao} {
        allow read, write: if liberado() && request.auth.uid == uid;
      }
    }

    // ================= atendimentos =================
    match /atendimentos/{id} {
      allow read: if liberado() && request.auth.uid in resource.data.participantes;
      allow create: if liberado() && idOk(id)
        && request.resource.data.criadoPor == request.auth.uid
        && request.auth.uid in request.resource.data.participantes
        && atendOk(request.resource.data);
      // Organizador edita tudo; participante só pode se retirar (a lista nova é a antiga sem ele, e nada mais muda).
      allow update: if liberado() && (
        (resource.data.criadoPor == request.auth.uid && request.resource.data.criadoPor == request.auth.uid
          && atendOk(request.resource.data))
        || (request.auth.uid in resource.data.participantes
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantes'])
            && request.resource.data.participantes == resource.data.participantes.removeAll([request.auth.uid]))
      );
      allow delete: if liberado() && resource.data.criadoPor == request.auth.uid;
    }

    // ================= clientes compartilhados =================
    match /compartilhados/{id} {
      allow read: if liberado() && request.auth.uid in resource.data.membros;
      allow create: if liberado() && idOk(id)
        && request.resource.data.dono == request.auth.uid
        && request.auth.uid in request.resource.data.membros
        && compartilhadoOk(request.resource.data);
      allow update: if liberado() && request.auth.uid in resource.data.membros
        && request.resource.data.dono == resource.data.dono
        && compartilhadoOk(request.resource.data)
        && (
          // dono: pode tudo (inclusive trocar parceiros)
          request.auth.uid == resource.data.dono
          // parceiro: só sai da lista, sem mexer em mais nada
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
              && request.resource.data.membros == resource.data.membros.removeAll([request.auth.uid]))
          // parceiro: atualiza o cliente, assinando como ele mesmo, e só a própria entrada da agenda
          || (request.resource.data.membros == resource.data.membros
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cliente','atualizado','atualizadoPor','cal'])
              && request.resource.data.atualizadoPor == request.auth.uid
              && (!('cal' in resource.data) || !('cal' in request.resource.data)
                  || request.resource.data.cal.diff(resource.data.cal).affectedKeys().hasOnly([request.auth.uid])))
        );
      allow delete: if liberado() && resource.data.dono == request.auth.uid;
    }
  }
}
